module bits (*)

import root


infixl 7 (.&.)
infixl 5 (.^.)
infixl 4 (.|.)


class Bits a where
  -- Bitwise AND
  (.&.) :: a -> a -> a

  -- Bitwise OR
  (.|.) :: a -> a -> a

  -- Bitwise XOR
  (.^.) :: a -> a -> a

  -- Left shift
  shiftl :: a -> Int -> a

  -- Right shift (arithmetic)
  shiftr :: a -> Int -> a

  -- Bitwise NOT (one's complement)
  bnot :: a -> a

  -- Test whether bit at position is set
  -- testBit 5 0 == True   (binary 101, bit 0 is set)
  testBit :: a -> Int -> Bool

  -- Set bit at position
  setBit :: a -> Int -> a

  -- Clear bit at position
  clearBit :: a -> Int -> a

  -- Toggle bit at position
  flipBit :: a -> Int -> a

  -- Count the number of set bits
  popcount :: a -> Int
